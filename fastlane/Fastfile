default_platform(:ios)

platform :ios do

  desc "Build signed IPA and upload to TestFlight"
  lane :beta do

    # ── 1. API Key ───────────────────────────────────────────────
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_content:  ENV["ASC_KEY_CONTENT"],
      duration:     1200,
      in_house:     false
    )

    # ── 2. Temporary keychain ────────────────────────────────────
    create_keychain(
      name:             "build.keychain",
      password:         "temppass123",
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # ── 3. Revoke ALL existing Distribution certs (limit = 2) ────
    require 'spaceship'
    key_content = ENV["ASC_KEY_CONTENT"].to_s.gsub("\\n", "\n")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key:       key_content,
      duration:  1200,
      in_house:  false
    )
    old_certs = Spaceship::ConnectAPI::Certificate.all(
      filter: { certificateType: "IOS_DISTRIBUTION" }
    )
    UI.message "Revoking #{old_certs.size} existing cert(s)..."
    old_certs.each { |c| c.delete!; UI.success "  Revoked #{c.id}" }

    # ── 4. Create fresh Distribution cert + install in keychain ──
    cert(
      api_key:           api_key,
      keychain_path:     "~/Library/Keychains/build.keychain-db",
      keychain_password: "temppass123",
      output_path:       "./build",
      force:             true
    )

    # ── 5. Write .p8 to disk for xcodebuild -allowProvisioningUpdates
    key_path = "/tmp/AuthKey.p8"
    File.write(key_path, key_content)

    # ── 6. Build & archive (Xcode auto-manages provisioning profile)
    gym(
      scheme:           "FacePass",
      configuration:    "Release",
      export_method:    "app-store",
      output_name:      "FacePass.ipa",
      output_directory: "./build",
      clean:            true,
      xcargs:           "-allowProvisioningUpdates " \
                        "-authenticationKeyPath #{key_path} " \
                        "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
                        "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    )

    # ── 7. Upload to TestFlight ──────────────────────────────────
    pilot(
      api_key:                           api_key,
      ipa:                               "./build/FacePass.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "Initial beta release"
    )

  end

end
