default_platform(:ios)

platform :ios do

  desc "Build signed IPA and upload to TestFlight"
  lane :beta do

    # ── 1. API Key ───────────────────────────────────────────────
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_content:  ENV["ASC_KEY_CONTENT"],
      duration:     1200,
      in_house:     false
    )

    # ── 2. Temporary keychain ────────────────────────────────────
    create_keychain(
      name:             "build.keychain",
      password:         "temppass123",
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # ── 3. Write .p8 key for xcodebuild -allowProvisioningUpdates ─
    key_id      = ENV["ASC_KEY_ID"]
    issuer_id   = ENV["ASC_ISSUER_ID"]
    key_content = ENV["ASC_KEY_CONTENT"].to_s.gsub("\\n", "\n")
    key_dir     = File.expand_path("~/private_keys")
    sh "mkdir -p '#{key_dir}'"
    key_file = "#{key_dir}/AuthKey_#{key_id}.p8"
    File.write(key_file, key_content)
    UI.success "API key written: #{key_file}"

    # ── 4. Build with automatic signing ──────────────────────────
    keychain_path = File.expand_path("~/Library/Keychains/build.keychain-db")
    gym(
      scheme:           "FacePass",
      configuration:    "Release",
      export_method:    "app-store",
      output_name:      "FacePass.ipa",
      output_directory: "./build",
      clean:            true,
      xcargs: [
        "DEVELOPMENT_TEAM=8RSCHWPSQP",
        "CODE_SIGN_STYLE=Automatic",
        "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain_path}'",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath '#{key_file}'",
        "-authenticationKeyID #{key_id}",
        "-authenticationKeyIssuerID #{issuer_id}"
      ].join(" "),
      export_options: {
        method:       "app-store",
        teamID:       "8RSCHWPSQP",
        signingStyle: "automatic"
      }
    )

    # ── 5. Upload to TestFlight ──────────────────────────────────
    pilot(
      api_key:                           api_key,
      ipa:                               "./build/FacePass.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "Initial beta release"
    )

  end

end
