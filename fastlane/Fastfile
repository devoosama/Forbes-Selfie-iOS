default_platform(:ios)

platform :ios do

  desc "Build signed IPA and upload to TestFlight"
  lane :beta do

    # ── 1. API Key ───────────────────────────────────────────────
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_content:  ENV["ASC_KEY_CONTENT"],
      duration:     1200,
      in_house:     false
    )

    # ── 2. Temporary keychain ────────────────────────────────────
    create_keychain(
      name:             "build.keychain",
      password:         "temppass123",
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # ── 3. Revoke existing Distribution certs (both types) ───────
    require 'spaceship'
    key_content = ENV["ASC_KEY_CONTENT"].to_s.gsub("\\n", "\n")
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id:    ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key:       key_content,
      duration:  1200,
      in_house:  false
    )
    old_certs = []
    ["IOS_DISTRIBUTION", "DISTRIBUTION"].each do |cert_type|
      found = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: cert_type })
      UI.message "  #{cert_type}: #{found.size} cert(s)"
      old_certs += found
    end
    UI.message "Revoking #{old_certs.size} existing cert(s)..."
    old_certs.each { |c| c.delete!; UI.success "  Revoked #{c.id}" }

    # ── 4. Create fresh Distribution cert ────────────────────────
    cert(
      api_key:           api_key,
      keychain_path:     "~/Library/Keychains/build.keychain-db",
      keychain_password: "temppass123",
      output_path:       "./build",
      force:             true
    )

    # ── 4b. Read actual Team ID from the installed cert ──────────
    kc_path = File.expand_path("~/Library/Keychains/build.keychain-db")
    cert_output = sh("security find-identity -v -p codesigning '#{kc_path}' 2>&1", log: false).strip
    UI.message "Keychain identities:\n#{cert_output}"
    team_match = cert_output.match(/(?:iPhone|Apple) Distribution:.+?\(([A-Z0-9]{10})\)/)
    actual_team_id = team_match ? team_match[1] : nil
    UI.success "Team ID from certificate: #{actual_team_id}"
    update_project_team(path: "FacePass.xcodeproj", teamid: actual_team_id) if actual_team_id

    # ── 5. Provisioning Profile ──────────────────────────────────
    sigh(
      api_key:        api_key,
      app_identifier: "tech.houarimed.facepass",
      force:          true
    )

    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    profile_src  = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profiles_dir = "#{ENV['HOME']}/Library/MobileDevice/Provisioning Profiles"
    sh "mkdir -p '#{profiles_dir}' && cp '#{profile_src}' '#{profiles_dir}/#{profile_uuid}.mobileprovision'"
    UI.success "Profile installed: #{profiles_dir}/#{profile_uuid}.mobileprovision"

    # ── 6. Manual signing with UUID-based profile ─────────────────
    update_code_signing_settings(
      use_automatic_signing: false,
      path:               "FacePass.xcodeproj",
      bundle_identifier:  "tech.houarimed.facepass",
      code_sign_identity: "Apple Distribution",
      profile_uuid:       profile_uuid
    )

    # ── 7. Build ─────────────────────────────────────────────────
    keychain_path = File.expand_path("~/Library/Keychains/build.keychain-db")
    gym(
      scheme:           "FacePass",
      configuration:    "Release",
      export_method:    "app-store",
      output_name:      "FacePass.ipa",
      output_directory: "./build",
      clean:            true,
      xcargs:           "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain_path}'"
    )

    # ── 7b. Debug: inspect IPA contents before upload ────────────
    begin
      ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
      ipa_abs  = File.expand_path(ipa_path.to_s)
      UI.message "IPA path: #{ipa_abs}"
      sh "unzip -o '#{ipa_abs}' -d '/tmp/ipa_inspect' 2>&1 | tail -5"
      plist = "/tmp/ipa_inspect/Payload/FacePass.app/Info.plist"
      if File.exist?(plist)
        UI.message "=== Info.plist in IPA ==="
        sh "plutil -p '#{plist}' 2>&1"
        UI.message "=== App bundle files ==="
        sh "ls '/tmp/ipa_inspect/Payload/FacePass.app/' 2>&1 | head -40"
      else
        UI.error "Info.plist NOT FOUND at #{plist}"
        sh "find /tmp/ipa_inspect -name 'Info.plist' 2>&1 | head -10"
      end
    rescue => e
      UI.error "IPA inspection failed: #{e.message}"
    end

    # ── 8. Upload to TestFlight ──────────────────────────────────
    pilot(
      api_key:                           api_key,
      ipa:                               "./build/FacePass.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "Initial beta release"
    )

  end

end
