default_platform(:ios)

platform :ios do

  desc "Build signed IPA and upload to TestFlight"
  lane :beta do

    # ── 1. API Key ───────────────────────────────────────────────
    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_content:  ENV["ASC_KEY_CONTENT"],
      duration:     1200,
      in_house:     false
    )

    # ── 2. Temporary keychain ────────────────────────────────────
    create_keychain(
      name:             "build.keychain",
      password:         "temppass123",
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # ── 3. Revoke old distribution certs (Apple limit = 2) ──────
    require 'spaceship'
    begin
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id:    api_key[:key_id],
        issuer_id: api_key[:issuer_id],
        key:       api_key[:key],
        duration:  1200,
        in_house:  false
      )
      old_certs = Spaceship::ConnectAPI::Certificate.all(
        filter: { certificateType: "IOS_DISTRIBUTION" }
      )
      old_certs.each do |c|
        UI.message "Revoking old cert #{c.id} (#{c.display_name})..."
        c.delete!
      end
      UI.success "Revoked #{old_certs.size} old cert(s)." if old_certs.any?
    rescue => e
      UI.important "Could not auto-revoke old certs: #{e.message}"
    end

    # ── 4. Distribution Certificate ──────────────────────────────
    cert(
      api_key:           api_key,
      keychain_path:     "~/Library/Keychains/build.keychain-db",
      keychain_password: "temppass123",
      output_path:       "./build",
      force:             true
    )

    # ── 5. Provisioning Profile ──────────────────────────────────
    sigh(
      api_key:        api_key,
      app_identifier: "tech.houarimed.facepass",
      force:          true
    )

    # Ensure profile is in the system directory Xcode searches
    sh "mkdir -p ~/Library/MobileDevice/'Provisioning Profiles' && " \
       "cp '#{lane_context[SharedValues::SIGH_PROFILE_PATH]}' " \
       "~/Library/MobileDevice/'Provisioning Profiles'/#{lane_context[SharedValues::SIGH_UUID]}.mobileprovision"

    # ── 5. Update signing settings ───────────────────────────────
    update_code_signing_settings(
      use_automatic_signing: false,
      path:             "FacePass.xcodeproj",
      bundle_identifier: "tech.houarimed.facepass",
      code_sign_identity: "iPhone Distribution",
      profile_name:     lane_context[SharedValues::SIGH_NAME]
    )

    # ── 6. Build ─────────────────────────────────────────────────
    gym(
      scheme:           "FacePass",
      configuration:    "Release",
      export_method:    "app-store",
      output_name:      "FacePass.ipa",
      output_directory: "./build",
      clean:            true
    )

    # ── 7. Upload to TestFlight ──────────────────────────────────
    pilot(
      api_key:                          api_key,
      ipa:                              "./build/FacePass.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                        "Initial beta release"
    )

  end

end
